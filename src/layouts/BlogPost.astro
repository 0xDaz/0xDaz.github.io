---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogPostSchema from '../components/BlogPostSchema.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLangFromUrl } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, categories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
		/>
		<BlogPostSchema
			title={title}
			description={description || ''}
			pubDate={pubDate}
			updatedDate={updatedDate}
			image={heroImage}
			url={Astro.url}
		/>
		<style is:global>
			main {
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				padding: 2em 1em;
			}

			article {
				background: transparent;
				border: none;
			}

			.hero-image {
				width: 100%;
				max-height: 500px;
				overflow: hidden;
				background: var(--bg-tertiary);
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				object-fit: cover;
				border: none;
				border-radius: 0;
			}

			.article-header {
				padding: 2em 0 1em;
				border-bottom: 1px dashed #666;
				margin-bottom: 2em;
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 1em;
				margin-bottom: 1em;
				flex-wrap: wrap;
			}

			.post-date {
				color: var(--color-accent);
				font-size: 0.9em;
			}

			.post-category {
				color: var(--color-accent);
				font-size: 0.9em;
			}

			.article-header h1 {
				font-size: 2.5em;
				margin: 0 0 0.5em 0;
				line-height: 1.2;
			}

			.post-description {
				color: var(--color-global-text);
				font-size: 1.1em;
				line-height: 1.6;
				margin: 0 0 1em 0;
			}

			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}

			.post-tag {
				color: var(--color-accent);
				font-size: 0.85em;
			}

			.divider {
				display: none;
			}

			.prose {
				margin: 0;
				padding: 0;
				color: var(--color-global-text);
				font-size: 1em;
				line-height: 1.8;
			}

			.prose p {
				margin-bottom: 1em;
				line-height: 1.8;
			}

			/* Style for label-style headings (e.g., **핵심 장점**:) */
			.prose p strong {
				font-size: 1.15em;
				font-weight: 700;
			}

			.prose h2,
			.prose h3,
			.prose h4 {
				margin-top: 2em;
				margin-bottom: 1em;
			}

			/* Better spacing for headings followed by lists */
			.prose h4 + ul,
			.prose h4 + ol {
				margin-top: 0.75em;
			}

			.prose ul,
			.prose ol {
				margin-top: 0.5em;
				margin-bottom: 1.5em;
			}

			/* Tighten spacing between consecutive list items sections */
			.prose ul + p strong,
			.prose ol + p strong {
				display: inline-block;
				margin-top: 0.5em;
			}

			.prose li {
				margin-bottom: 0.25em;
			}

			.prose li:last-child {
				margin-bottom: 0;
			}

			.prose pre {
				margin-top: 0.5em;
				margin-bottom: 1.5em;
			}

			.back-link {
				display: inline-block;
				margin-bottom: 2em;
				text-decoration: none;
				color: var(--color-link);
			}

			.back-link:hover {
				text-decoration: underline;
			}

			@media (max-width: 768px) {
				.article-header h1 {
					font-size: 2em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<a href={getRelativeLocaleUrl(lang, '/blog')} class="back-link">
				← Back to Posts
			</a>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1200} height={600} src={heroImage} alt="" />
					</div>
				)}
				<div class="article-header">
					<div class="post-meta">
						<span class="post-date">
							<FormattedDate date={pubDate} />
						</span>
						{categories && categories.length > 0 && (
							<span class="post-category">{categories[0]}</span>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="post-description">{description}</p>}
					{tags && tags.length > 0 && (
						<div class="post-tags">
							{tags.map(tag => (
								<span class="post-tag">#{tag}</span>
							))}
						</div>
					)}
					<div class="divider"></div>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
