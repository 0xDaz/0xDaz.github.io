---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations('en'); // Always use English for UI
---

<header>
	<nav>
		<h2><a href={getRelativeLocaleUrl(lang, '/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={getRelativeLocaleUrl(lang, '/')}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={getRelativeLocaleUrl(lang, '/blog')}>{t('nav.blog')}</HeaderLink>
		</div>
		<div class="social-links">
			<!-- Language Picker -->
			<LanguagePicker />
			<!-- GitHub Link -->
			<a href="https://github.com/0xDaz" target="_blank" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 2em 0;
		border-bottom: 1px dashed #666;
		margin-bottom: 2em;
	}

	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 600;
	}

	h2 a {
		text-decoration: none;
		color: var(--color-accent-2);
	}

	h2 a:hover {
		color: var(--color-link);
	}

	nav {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1em;
		gap: 2em;
	}

	.internal-links {
		display: flex;
		gap: 1em;
		align-items: center;
		justify-content: flex-start;
	}

	.internal-links :global(a) {
		text-decoration: none;
		color: var(--color-global-text);
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--color-link);
		text-decoration: underline;
	}

	.social-links {
		display: flex;
		gap: 0.75em;
		align-items: center;
		justify-self: end;
	}

	.social-links a {
		color: var(--color-global-text);
		transition: color 0.2s ease;
	}

	.social-links a:hover {
		color: var(--color-link);
	}

	.language-picker {
		display: flex;
		gap: 0.5em;
	}

	.language-picker a {
		text-decoration: none;
		color: var(--color-global-text);
		font-size: 0.9em;
	}

	.language-picker a:hover,
	.language-picker a.active {
		color: var(--color-link);
	}

	@media (max-width: 720px) {
		nav {
			grid-template-columns: 1fr;
			gap: 1em;
		}

		.internal-links {
			justify-content: center;
		}

		.social-links {
			justify-self: center;
		}
	}
</style>
