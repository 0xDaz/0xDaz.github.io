---
import { SITE_TITLE } from '../consts';

const schema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"url": "https://0xdaz.github.io",
	"description": "Developer blog about AI, Game Development, and Development Environment",
	"inLanguage": ["en", "ko", "ja", "zh"],
	"potentialAction": {
		"@type": "SearchAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": "https://0xdaz.github.io/blog?search={search_term_string}"
		},
		"query-input": "required name=search_term_string"
	},
	"author": {
		"@type": "Person",
		"name": "0xDaz",
		"url": "https://0xdaz.github.io"
	}
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
