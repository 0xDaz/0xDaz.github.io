---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { SITE_TITLE } from '../../../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
	.filter(post => {
		return post.id.startsWith('zh/');
	})
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`Posts | ${SITE_TITLE}`} />
		<style>
			.page-header {
				margin-bottom: 3em;
				padding-bottom: 1em;
				border-bottom: 1px dashed #666;
			}

			.page-header h1 {
				font-size: 2em;
				margin-bottom: 0.5em;
			}

			.page-header p {
				color: var(--color-accent);
				font-size: 1em;
			}

			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-item {
				padding: 1.5em 0;
				border-bottom: 1px dashed #ddd;
			}

			.post-item:last-child {
				border-bottom: none;
			}

			.post-item a {
				display: block;
				text-decoration: none;
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.75em;
				margin-bottom: 0.5em;
			}

			.post-date {
				color: var(--color-accent);
				font-size: 0.9em;
			}

			.post-category {
				color: var(--color-accent);
				font-size: 0.9em;
			}

			.post-title {
				margin: 0 0 0.5em 0;
				color: var(--color-accent-2);
				font-size: 1.25em;
				font-weight: 600;
				line-height: 1.4;
			}

			.post-item a:hover .post-title {
				color: var(--color-link);
			}

			.post-description {
				color: var(--color-global-text);
				font-size: 0.95em;
				line-height: 1.6;
				margin: 0 0 0.75em 0;
			}

			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}

			.post-tag {
				color: var(--color-accent);
				font-size: 0.85em;
			}

			@media (max-width: 768px) {
				.page-header h1 {
					font-size: 1.75em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Posts</h1>
				<p>{posts.length} posts</p>
			</div>
			<ul class="posts-list">
				{
					posts.map((post) => {
						// Remove 'zh/' prefix and convert to lowercase
						const slug = post.id.replace(/^zh\//, '').toLowerCase();
						return (
						<li class="post-item">
							<a href={`/zh/blog/${slug}/`}>
								<div class="post-meta">
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									{post.data.categories && post.data.categories.length > 0 && (
										<span class="post-category">• {post.data.categories[0]}</span>
									)}
								</div>
								<h3 class="post-title">{post.data.title}</h3>
								{post.data.description && (
									<p class="post-description">{post.data.description}</p>
								)}
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="post-tags">
										{post.data.tags.slice(0, 5).map(tag => (
											<span class="post-tag">#{tag}</span>
										))}
									</div>
								)}
							</a>
						</li>
					)})
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
