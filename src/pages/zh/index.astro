---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_TITLE } from '../../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations('en'); // Always use English for UI

// Get all posts from all languages, limit to 6
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
	.filter(post => {
		if (lang === 'en') {
			// English posts have no language prefix (AI/, GameDev/, Env/)
			return !post.id.startsWith('en/') && !post.id.startsWith('ko/') && !post.id.startsWith('ja/') && !post.id.startsWith('zh/');
		}
		return post.id.startsWith(`${lang}/`);
	})
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} />
		<style>
			.hero {
				margin-bottom: 3em;
			}

			.hero h1 {
				font-size: 3em;
				margin-bottom: 0.5em;
			}

			.hero .subtitle {
				font-size: 1.2em;
				color: var(--color-accent);
				margin-bottom: 1.5em;
			}

			.hero .subtitle a {
				color: var(--color-link);
			}

			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin: 3em 0 1.5em 0;
				border-bottom: 1px dashed #666;
				padding-bottom: 0.5em;
			}

			.section-title {
				font-size: 1.5em;
				margin: 0;
			}

			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-item {
				padding: 1em 0;
				border-bottom: 1px dashed #ddd;
			}

			.post-item:last-child {
				border-bottom: none;
			}

			.post-item a {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 1em;
				text-decoration: none;
			}

			.post-date {
				color: var(--color-accent);
				font-size: 0.9em;
				min-width: 100px;
			}

			.post-title {
				color: var(--color-accent-2);
				font-weight: 600;
			}

			.post-item a:hover .post-title {
				color: var(--color-link);
			}

			@media (max-width: 768px) {
				.hero h1 {
					font-size: 2em;
				}

				.hero .subtitle {
					font-size: 1em;
				}

				.post-item a {
					grid-template-columns: 1fr;
					gap: 0.25em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>0xDaz</h1>
				<p class="subtitle">
					?ìç Seoul ???íº Programmer ???ìß <a href="mailto:esnetni2@gmail.com">esnetni2@gmail.com</a>
				</p>
			</section>

			<section>
				<div class="section-header">
					<h2 class="section-title">{t('nav.blog')}</h2>
					<a href={getRelativeLocaleUrl(lang, '/blog')}>{t('readMore')} ??/a>
				</div>
				<ul class="posts-list">
					{
						posts.map((post) => {
							const pathWithoutLang = post.id.split('/').slice(1).join('/').toLowerCase();
							return (
							<li class="post-item">
								<a href={`/zh/blog/${pathWithoutLang}/`}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="post-title">{post.data.title}</span>
								</a>
							</li>
						)})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
